  "sources": [
    {
      "id": "src_model",
      "label": "Backtest temporal del modelo",
      "path": "data/model-results/metrics.json",
      "query": {
        "engine": "duckdb",
        "sql": "SELECT * FROM read_json_auto('data/model-results/metrics.json')",
        "language": "sql",
        "description": "Regresión logística regularizada y random forest comparados con TimeSeriesSplit; holdout final = 30% más reciente.",
        "tables_used": [
          "data/model-results/metrics.json"
        ],
        "filters": [
          "Estado de Pago en Pagado/Cancelada",
          "Fecha y Total válidos",
          "Sólo variables disponibles al crear el pedido"
        ],
        "metric_definitions": [
          "ROC-AUC: probabilidad de ordenar un cancelado por encima de un pagado.",
          "PR-AUC: precisión promedio a lo largo de niveles de recall; baseline = prevalencia del holdout.",
          "Lift@20%: tasa de cancelación del 20% con mayor score dividida por la tasa del holdout."
        ],
        "executed_at": "2026-08-29T21:20:00-04:00"
      }
    },
    {
      "id": "src_lift",
      "label": "Curva de lift del holdout",
      "path": "data/model-results/lift_curve.csv",
      "query": {
        "engine": "duckdb",
        "sql": "SELECT * FROM read_csv_auto('data/model-results/lift_curve.csv', header=true)",
        "language": "sql",
        "description": "Pedidos del holdout ordenados por score descendente y acumulados por profundidad de contacto.",
        "tables_used": [
          "data/model-results/lift_curve.csv"
        ],
        "filters": [
          "Holdout temporal: 157 pedidos posteriores a 2026-05-25 16:45"
        ],
        "metric_definitions": [
          "Capture rate: cancelaciones dentro del tramo / 18 cancelaciones del holdout."
        ],
        "executed_at": "2026-08-29T21:20:00-04:00"
      }
    },
    {
      "id": "src_geo",
      "label": "Pedidos históricos agregados por región",
      "path": "data/model-results/geo_segments.csv",
      "query": {
        "engine": "duckdb",
        "sql": "SELECT * FROM read_csv_auto('data/model-results/geo_segments.csv', header=true) WHERE orders >= 10",
        "language": "sql",
        "description": "Agregación sin PII de pedidos, cancelaciones, ingreso pagado y ticket promedio por región.",
        "tables_used": [
          "data/model-results/geo_segments.csv"
        ],
        "filters": [
          "Regiones con al menos 10 pedidos en la tabla/gráfico principal"
        ],
        "metric_definitions": [
          "Tasa de cancelación = cancelaciones / pedidos.",
          "Ticket pagado = ingreso de pedidos pagados / pedidos pagados."
        ],
        "executed_at": "2026-08-29T21:20:00-04:00"
      }
    },
    {
      "id": "src_ga4",
      "label": "GA4 Sagasmusicshop.cl · snapshot autenticado",
      "path": "data/ga4_snapshot_2026-08-29.csv",
      "query": {
        "engine": "duckdb",
        "sql": "SELECT * FROM read_csv_auto('data/ga4_snapshot_2026-08-29.csv', header=true) WHERE scope IN ('channel', 'region')",
        "description": "Lectura agregada de Traffic acquisition y Demographic details en GA4.",
        "tables_used": [
          "data/ga4_snapshot_2026-08-29.csv"
        ],
        "filters": [
          "Periodo 2026-08-01 a 2026-08-28",
          "Default channel group o Region"
        ],
        "metric_definitions": [
          "Share de sesiones = sesiones del canal / 40.948 sesiones.",
          "Share de ingresos = ingreso del canal / CLP 4.712.951.",
          "Ingreso por mil sesiones = ingreso / sesiones × 1.000; no equivale a ROAS porque falta costo."
        ],
        "executed_at": "2026-08-29T20:25:00-04:00",
        "language": "sql"
      }
    },
    {
      "id": "src_shipping",
      "label": "Pedidos históricos agregados por despacho",
      "path": "data/model-results/shipping_segments.csv",
      "query": {
        "engine": "duckdb",
        "sql": "SELECT * FROM read_csv_auto('data/model-results/shipping_segments.csv', header=true) WHERE orders >= 20",
        "language": "sql",
        "description": "Agregación sin PII por método de envío.",
        "tables_used": [
          "data/model-results/shipping_segments.csv"
        ],
        "filters": [
          "Métodos con al menos 20 pedidos"
        ],
        "metric_definitions": [
          "Tasa de cancelación = cancelaciones / pedidos."
        ],
        "executed_at": "2026-08-29T21:20:00-04:00"
      }
    }
  ]
